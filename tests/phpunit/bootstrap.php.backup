/**
 * Mock dynamique pour les options WordPress
 *
 * Simule get_option() avec des fixtures par défaut pour éviter
 * les appels DB pendant les tests.
 *
 * Usage :
 *   MockOptions::reset();                     // Reset aux valeurs initiales
 *   MockOptions::$data['key']['field'] = 'X'; // Modifier pour un test
 *
 * Fixtures :
 *   - woocommerce_payline_settings : Configuration globale
 *     - merchant_id : 'MERCH' (mock, invalide pour API réelle)
 *     - access_key : 'KEY' (mock, invalide pour API réelle)
 *     - environment : 'HOMO' (Homologation/test Monext)
 *
 *   - woocommerce_payline_nx_settings : Configuration NX (3x/4x)
 *     - merchant_id : 'NX_MERCH'
 *     - access_key : 'NX_KEY'
 *     - widget_integration : 'redirection'
 *
 *   - woocommerce_payline_cpt_settings : Configuration CPT (comptant)
 *     - wallet : 'yes' (portefeuille activé)
 *
 *   - woocommerce_wrong_sdk_call_settings : Cas de test pour credentials manquants
 *     (utilisé pour tester que getSDK() retourne null si credentials absents)
 */
class MockOptions {
    private static $fixtures = [
        'woocommerce_payline_settings' => [
            'merchant_id' => 'MERCH',
            'access_key' => 'KEY',
            'environment' => 'HOMO'
        ],
        'woocommerce_payline_nx_settings' => [
            'merchant_id' => 'NX_MERCH',
            'access_key' => 'NX_KEY',
            'environment' => 'HOMO',
            'widget_integration' => 'redirection'
        ],
        'woocommerce_payline_cpt_settings' => [
            'merchant_id' => 'NX_MERCH',
            'access_key' => 'NX_KEY',
            'environment' => 'HOMO',
            'widget_integration' => 'redirection',
            'wallet' => 'yes'
        ],
        'woocommerce_wrong_sdk_call_settings' => [
            'environment' => 'HOMO',
            'widget_integration' => 'redirection'
        ]
    ];

    public static $data = [];

    public static function reset(): void
    {
        self::$data = self::$fixtures;
    }

    public static function getFixtures(): array
    {
        return self::$fixtures;
    }
}

MockOptions::reset();

if (!function_exists('get_option')) {
    function get_option($key, $default = []) {
        return MockOptions::$data[$key] ?? $default;
    }
}

/**
 * Mock dynamique pour les données des plugins
 *
 * Simule get_plugin_data() et get_plugins() pour éviter
 * les appels filesystem pendant les tests.
 *
 * Usage :
 *   MockPlugins::reset();                              // Reset aux valeurs initiales
 *   MockPlugins::$data['payline']['Version'] = '2.0'; // Modifier pour un test
 *
 * Fixtures :
 *   - payline : Métadonnées du plugin Payline
 *     - Version : '1.5.8' (utilisé par getExtensionVersion())
 *
 *   - woocommerce : Métadonnées du plugin WooCommerce
 *     - Version : '10.3.5'
 */
class MockPlugins {
