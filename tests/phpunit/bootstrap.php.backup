        public function get_shipping_city($context = 'view') {
            return $this->shipping['city'];
        }

        public function get_shipping_postcode($context = 'view') {
            return $this->shipping['postcode'];
        }

        public function get_shipping_country($context = 'view') {
            return $this->shipping['country'];
        }

        public function get_shipping_company($context = 'view') {
            return $this->shipping['company'];
        }

        public function get_shipping_phone($context = 'view') {
            return isset($this->shipping['phone']) ? $this->shipping['phone'] : '';
        }

        // Articles
        public function get_items($types = 'line_item') {
            return $this->items;
        }

        // User
        public function get_user_id($context = 'view') {
            return $this->user_id;
        }

        // URLs
        public function get_checkout_order_received_url() {
            return 'https://example.com/checkout/order-received/' . $this->id;
        }

        public function get_cancel_order_url($redirect = '') {
            return 'https://example.com/checkout/order-cancelled/' . $this->id;
        }

        // Notes
        public function add_order_note($note, $is_customer_note = 0, $added_by_user = false) {
            $this->order_notes[] = array(
                'content' => $note,
                'customer_note' => $is_customer_note,
                'added_by' => $added_by_user,
            );
        }

        public function get_order_notes() {
            return $this->order_notes;
        }

        // Save
        public function save() {
            return $this->id;
        }

        // Setters pour les tests
        public function set_id($id) {
            $this->id = $id;
        }

        public function set_billing($billing) {
            $this->billing = array_merge($this->billing, $billing);
        }

        public function set_shipping($shipping) {
            $this->shipping = array_merge($this->shipping, $shipping);
        }

        public function set_items($items) {
            $this->items = $items;
        }

        public function set_user_id($user_id) {
            $this->user_id = $user_id;
        }

        // Compléter le paiement (marquer commande payée + transaction ID)
        public function payment_complete($transaction_id = '') {
            if ($transaction_id) {
                $this->set_transaction_id($transaction_id);
            }
            $this->update_status('processing', 'Payment complete');
            return true;
        }
    }
}

// Fonction globale wc_get_order avec cache pour les tests
if (!function_exists('wc_get_order')) {
    function wc_get_order($order_id) {
        static $order_cache = array();

        if ($order_id instanceof WC_Order) {
            // Sauvegarder dans le cache
            $order_cache[$order_id->get_id()] = $order_id;
            return $order_id;
        }

        // Retourner du cache si disponible
        if (isset($order_cache[$order_id])) {
            return $order_cache[$order_id];
        }

        // Créer nouveau et mettre en cache
        $order = new WC_Order($order_id);
        $order_cache[$order_id] = $order;
        return $order;
    }
}

// Mock $_SERVER pour les tests
if (!isset($_SERVER['REMOTE_ADDR'])) {
    $_SERVER['REMOTE_ADDR'] = '127.0.0.1';
}

// Fonction WC() pour WooCommerce global (utilisée par get_error_payment_url)
if (!function_exists('WC')) {
    function WC() {
        static $wc = null;
        if ($wc === null) {
            $wc = new stdClass();
            // Mock cart avec get_cart_hash()
            $wc->cart = new class {
                public function get_cart_hash() {
                    return md5('test_cart_hash');
                }
            };
            $wc->session = new stdClass();
        }
        return $wc;
    }
}

// Fonction WordPress is_user_logged_in()
if (!function_exists('is_user_logged_in')) {
    function is_user_logged_in() {
        return false;  // Par défaut, utilisateur non connecté dans les tests
    }
}

